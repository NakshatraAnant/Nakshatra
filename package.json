{
  "name": "nakshatra",
  "version": "0.1.0",
  "private": true,
  "description": "Nakshatra — cosmic identity, astrology, relationships and lifecycle platform",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "esbuild src/server/main.ts src/server/db/seed-cli.ts src/server/db/migrate-cli.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outdir=dist/server --entry-names=[name]",
    "start": "node --enable-source-maps dist/server/main.js",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json",
    "lint": "eslint src tests e2e scripts",
    "test": "vitest run",
    "test:unit": "vitest run src/astro src/shared",
    "test:watch": "vitest",
    "test:e2e": "npm run build:web && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "db:seed": "tsx src/server/db/seed-cli.ts",
    "guest": "tsx scripts/create-guest.ts",
    "db:reset": "tsx src/server/db/reset-cli.ts",
    "db:backup": "tsx src/server/db/backup-cli.ts",
    "audit:secrets": "tsx scripts/secret-scan.ts",
    "db:restore": "tsx src/server/db/restore-cli.ts",
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "build:web:e2e": "vite build --outDir .data/e2e-web --emptyOutDir",
    "bench:api": "tsx scripts/bench-api.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.104.5",
    "all-the-cities": "3.1",
    "astronomy-engine": "^2.1.19",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "geo-tz": "^8.1.10",
    "luxon": "^3.7.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "1.5",
    "react": "19.2",
    "react-dom": "19.2",
    "react-router": "7.18",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
