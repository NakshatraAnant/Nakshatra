# Nakshatra configuration. Copy to .env and adjust. Never commit .env.
# Every variable is optional for local development; defaults are shown.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Behind a reverse proxy / load balancer set the number of trusted hops (usually 1) so client IPs are correct.
TRUST_PROXY=0
# Origin the browser uses (the Vite dev server in development).
# On Render, APP_ORIGIN defaults to RENDER_EXTERNAL_URL; set it explicitly for a custom domain.
APP_ORIGIN=http://localhost:5173

# Database. Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) in PGLITE_DIR.
# DATABASE_URL=postgres://nakshatra:<password>@localhost:5432/nakshatra
PGLITE_DIR=./.data/pglite
# Hosted PostgreSQL: PEM CA certificate to verify the server (e.g. Supabase > Database settings > SSL). Single-line values may use \n.
# DATABASE_CA_CERT=
# DATABASE_POOL_MAX=10

# At least 32 random characters. Required when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Payments: dev_simulator (labelled, no real money; refused in production) | none | razorpay
# razorpay: orders are created server-side, Razorpay Checkout collects payment, and state changes only
# through webhooks signed with RAZORPAY_WEBHOOK_SECRET at POST /api/v1/payments/webhook/razorpay
# (subscribe to payment.captured, payment.failed, refund.processed, refund.failed).
PAYMENT_PROVIDER=dev_simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email: dev_mailbox stores mail in the database (view at /dev/mailbox; refused in production) | smtp
# SMTP_URL examples: smtp://user:pass@smtp.example.com:587 (STARTTLS) or smtps://user:pass@smtp.example.com:465
MAIL_TRANSPORT=dev_mailbox
SMTP_URL=
MAIL_FROM=Nakshatra <no-reply@nakshatra.local>

# Not integrated in this build; the UI reports these as unavailable.
VIDEO_PROVIDER=none
PUSH_PROVIDER=none

LOG_LEVEL=info
# Load clearly-labelled sample experts, products and vendors when running `npm run db:seed`.
SEED_DEMO_DATA=true

# Docker Compose only: password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=
